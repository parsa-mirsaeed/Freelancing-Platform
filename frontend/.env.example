# Server-only URL for the Flask API. Never expose this with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:8000

# Public Socket.IO origin only; credentials are fetched as 60-second scoped tickets through the BFF.
# Leave unset to use durable REST cursor synchronization without a live socket.
NEXT_PUBLIC_REALTIME_URL=http://localhost:8000

# Browser-visible provider selector. Keep sandbox for local/CI. Production payment builds use stripe.
# Stripe publishable keys are returned ephemerally by the authenticated payment-action endpoint;
# never place STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_PAYMENT_PROVIDER=sandbox
